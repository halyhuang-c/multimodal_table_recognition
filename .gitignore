# ── 隐私配置（API Key 等机密）────────────────────────────────────
# .env 存有 DASHSCOPE_API_KEY / TOKEN_PLAN_API_KEY，绝不入库；
# 模板 .env.example（空值）保留入库供他人参照
.env
.env.local
.env.*.local

# ── 运行时产物（可重新生成，不入库）──────────────────────────────
# 中间过程与逐题答案（runs/work/answers）
runs/
# 识别缓存（cache/pages 渲染图 + cache/tables，可重建）
cache/
# ChromaDB 向量库（可重建，重建后需重启 Web 服务）
vectorstore/
# 按日期/大小滚动的运行日志
logs/
# 最终产物 result.xlsx / result_debug.xlsx / cost_report.csv
output/
# 质量报告（gen_quality_report.py 生成，脚本本身保留入库）
postcheck/*.html

# ── 数据集（外部二进制大文件，不入库）────────────────────────────
# 92 个目标 PDF/图片（约 18MB）
files/

# ── Python ──────────────────────────────────────────────────────
.venv/
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# ── IDE / 操作系统 ───────────────────────────────────────────────
.idea/
.vscode/
Thumbs.db
Desktop.ini
# Excel 打开时的锁文件
~$*.xlsx
*.log
